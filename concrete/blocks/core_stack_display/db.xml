<?xml version="1.0" encoding="UTF-8"?>
<schema
  xmlns="http://www.concrete5.org/doctrine-xml/0.5"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.concrete5.org/doctrine-xml/0.5 https://concretecms.github.io/doctrine-xml/doctrine-xml-0.5.xsd">

  <table name="btCoreStackDisplay">
    <field name="bID" type="integer">
      <unsigned/>
      <key/>
      <notnull/>
    </field>
    <field name="stID" type="integer" comment="The ID of the stack displayed by the block (0: none, which is what an import that fails to find the stack leaves behind)">
      <unsigned/>
      <notnull/>
    </field>
    <index name="stID">
      <col>stID</col>
    </index>
  </table>

</schema>
