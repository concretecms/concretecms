# PHPStan configuration for the Concrete CMS code base: see README.md for how to run it and for the details.
includes:
    - vendor/phpstan/phpstan-doctrine/extension.neon
    - baseline.neon

parameters:
    level: 5
    # PHPStan itself requires PHP 7.4+, but the code must be compatible with PHP 7.3 to the latest PHP version supported by
    # PHPStan (max must be updated when PHPStan adds the support for new PHP versions: PHPStan refuses greater values).
    # The signatures of the PHP functions are the ones of the min version, the value of PHP_VERSION_ID is the whole range.
    phpVersion:
        min: 70300
        max: 80599
    tmpDir: tmp
    # The Composer project of Concrete (its vendor directory is concrete/vendor), so that PHPStan finds the classes
    # and the functions defined by the dependencies regardless of the current working directory
    composerAutoloaderProjectPaths:
        - %rootDir%/../../../..
    paths:
        - ../concrete/src
        - ../concrete/controllers
    excludePaths:
        # Requires php-cs-fixer, which is not a dependency
        - ../concrete/src/Support/CodingStyle
        # Files generated by the c5:ide-symbols CLI command (so they may not exist):
        # metadata for PhpStorm and stubs of the legacy class aliases for IDEs (the actual aliases are registered by the bootstrap file)
        - ../concrete/src/Support/.phpstorm.meta.php (?)
        - ../concrete/src/Support/__IDE_SYMBOLS__.php (?)
        # Stubs for PHPStan generated by the c5:ide-symbols CLI command (used as stubFiles, see below)
        - ../concrete/src/Support/__PHPSTAN_STUBS__.php (?)
    # Classes marked with #[\AllowDynamicProperties] (their properties are set dynamically, for example from database rows).
    # PHPStan doesn't consider that attribute when checking the property accesses (regardless of the analyzed PHP version,
    # so this will still be needed when the minimum PHP version will be 8.2 or later), so we list them here (their subclasses are included).
    universalObjectCratesClasses:
        - Concrete\Core\Foundation\ConcreteObject
        - Concrete\Core\Legacy\Model
        - Concrete\Core\Calendar\Event\EventRepetition
    # Don't assume that calling again a method without a declared return type gives the same result: for example,
    # PageController::isReplaced() may change after runAction() (which may call PageController::replace())
    rememberPossiblyImpureFunctionValues: false
    bootstrapFiles:
        - bootstrap.php
    # Constants whose value depends on the environment (PHPStan would otherwise assume the values of this instance).
    # The constants that can be overridden before the bootstrap (DIRNAME_APPLICATION, DIR_BASE, DISPATCHER_FILENAME, ...) and the
    # ones derived from the configuration (APP_VERSION, APP_CHARSET, ...) are deliberately not listed here.
    dynamicConstantNames:
        # true when the core has been updated by placing it in the updates directory (see concrete/bootstrap/configure.php)
        - APP_UPDATED_PASSTHRU
        # the name of the directory containing the updated core (only defined when the core has been updated)
        - DIRNAME_APP_UPDATED
        # true when Concrete is booted without processing any request (that's what the PHPStan bootstrap does)
        - C5_ENVIRONMENT_ONLY
        # a random string
        - C5_EXECUTE
        # the error reporting level at startup
        - INITIAL_ERROR_REPORTING
        # computed from the permissions of the application/files directory
        - DIRECTORY_PERMISSIONS_MODE_COMPUTED
        - FILE_PERMISSIONS_MODE_COMPUTED
        # the base URL of the site, defined by the runner while processing a request (see bootstrap.php)
        - BASE_URL
        # the relative path of the web root (empty when Concrete is installed in the root of the web site)
        - DIR_REL
    stubFiles:
        # Generated by the c5:ide-symbols CLI command: it describes the methods handled by __call/__callStatic with @method annotations.
        # PHPStan validates the stub files in isolation, so the generated file must declare every class it references,
        # except the ones already declared by the stubs of phpstan-doctrine (hence the --phpstan-other-stubs option)
        - ../concrete/src/Support/__PHPSTAN_STUBS__.php
        # Hand-written stubs fixing the PHPDoc of third-party libraries
        - stubs/gettext-3.stub
        - stubs/html-object.stub
        - stubs/illuminate-filesystem.stub
        - stubs/league-flysystem-1.stub
        - stubs/league-fractal-0.stub
    scanFiles:
        # Declarations of the lcobucci/jwt 4.x classes used by the code (composer.lock installs 3.4.6): see the file itself
        - stubs/lcobucci-jwt-4.php
    doctrine:
        # Lets phpstan-doctrine know the entity metadata (magic findBy*/findOneBy* repository methods, entity fields, ...)
        objectManagerLoader: object-manager.php
    ignoreErrors:
        # The private properties of the API models only carry the OpenAPI annotations (swagger-php) describing the API schemas:
        # they are never used by the code
        -
            identifier: property.unused
            paths:
                - ../concrete/src/Api/Model/*
                - ../concrete/src/Api/Response/*
        # Traits may be used only outside the analysed paths, or they may be helpers for implementing the interfaces
        # in third-party code
        -
            identifier: trait.unused
        # Methods meant to be extended call the parent implementation even when it's empty (AbstractController::on_start(),
        # Access::save()): the calls are harmless, and they keep working if the parent implementation will do something
        -
            message: '#^Call to Concrete\\Core\\Controller\\AbstractController\:\:on_start\(\) on a separate line has no effect\.$#'
            identifier: staticMethod.resultUnused
        -
            message: '#^Call to Concrete\\Core\\Permission\\Access\\Access\:\:save\(\) on a separate line has no effect\.$#'
            identifier: staticMethod.resultUnused
        # application/config/database.php only exists in installed instances
        -
            message: '#^Path in include\(\) ".*/application/config/database\.php" is not a file or it does not exist\.$#'
            identifier: include.fileNotFound
            path: ../concrete/src/Foundation/Runtime/Boot/DefaultBooter.php
            reportUnmatched: false
        # application/config/update.php only exists in instances that use an updated core
        -
            message: '#^Path in include\(\) ".*/application/config/update\.php" is not a file or it does not exist\.$#'
            identifier: include.fileNotFound
            path: ../concrete/src/Updater/ApplicationUpdate.php
            reportUnmatched: false
