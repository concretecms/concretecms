{
  "$schema": "https://json-schema.org/draft-07/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "requiredBlockTypes": {
        "type": "array",
        "items": {
            "type": "string",
            "minLength": 1
        },
        "uniqueItems": true
    },
    "importerExporterMethod": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(import|export)[a-zA-Z0-9_]+$"
    },
    "keepXmlElementsOrder": {
      "type": "boolean"
    },
    "fileUsageCount": {
      "type": "integer",
      "minimum": 0
    },
    "richTextsWithPages": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "richTextsWithImages": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "richTextsWithFiles": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    }
  },
  "required": [
  ],
  "additionalProperties": false
}
